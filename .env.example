# Select exactly one blockchain backend:
#   light-api  - PEPEW/PEPEPOW REST API (recommended default)
#   wallet-rpc - local PEPEPOW daemon/wallet JSON-RPC
PEPEPOW_CHAIN_PROVIDER=light-api

# REST API. Change this if your reverse proxy exposes the API under a path prefix.
PEPEPOW_LIGHT_API_URL=https://light.pepepow.net
PEPEPOW_LIGHT_API_KEY=

# Local node/wallet RPC. Never commit real credentials.
PEPEPOW_RPC_URL=http://127.0.0.1:8093
PEPEPOW_RPC_USER=
PEPEPOW_RPC_PASSWORD=

# Reserved for a future database adapter.
DATABASE_URL=
